{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atrapacuentos Studio",
  "version": "1.2.0",
  "identifier": "cl.atrapacuentos.studio",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Atrapacuentos Studio",
        "width": 1400, "height": 860, "minWidth": 1000, "minHeight": 640,
        "backgroundColor": "#14162a",
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-gpu-rasterization --enable-zero-copy --ignore-gpu-blocklist --enable-features=CanvasOopRasterization --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding"
      }
    ],
    "security": { "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' data: blob: mediastream: asset: http://asset.localhost; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost data: blob: https://cdn.jsdelivr.net https://storage.googleapis.com; object-src 'none'; base-uri 'self'; frame-src 'none'" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "category": "GraphicsAndDesign",
    "shortDescription": "Cuentos animados a MP4",
    "resources": { "bin/*": "bin/" },
    "windows": { "nsis": { "installMode": "both", "languages": ["Spanish"] } }
  }
}
