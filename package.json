{
  "name": "atrapacuentos-studio",
  "productName": "Atrapacuentos Studio",
  "version": "1.0.0",
  "description": "Crea cuentos animados arrastrando y soltando y expórtalos a MP4",
  "main": "main.js",
  "author": "Atrapacuentos <contacto@atrapacuentos.cl>",
  "license": "UNLICENSED",
  "scripts": {
    "preparar": "node prepare.js",
    "start": "node prepare.js && electron .",
    "dist:win": "node prepare.js && electron-builder --win --publish never",
    "dist:linux": "node prepare.js && electron-builder --linux --publish never"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "cl.atrapacuentos.studio",
    "productName": "Atrapacuentos Studio",
    "files": [
      "main.js",
      "app/**/*",
      "package.json"
    ],
    "directories": {
      "output": "instaladores"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics"
    }
  }
}